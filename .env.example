# ─── 必填 ───
# Discord Bot Token（从 https://discord.com/developers/applications 获取）
DISCORD_TOKEN=your_bot_token_here

# ─── 可选 ───
# 存储服务器（子区模式无需填写）。
# 如果使用「独立服务器」存储模式，在此填写存储服务器的 Guild ID，
# 并把 Bot 邀请进该服务器。
# STORAGE_GUILD_ID=

# 数据库文件路径
# DATABASE_PATH=data/repository.db

# 单个文件上传大小上限（MB），超过会被拒绝（默认 24MB）
# MAX_FILE_SIZE_MB=24

# 服务条款 / 隐私政策全文链接（可选）。配置后，首次使用的同意提示中会展示这两个链接。
# 可直接使用仓库中的文件地址，例如：
# TOS_URL=https://github.com/<你的账号>/<仓库>/blob/main/TERMS_OF_SERVICE.md
# PRIVACY_URL=https://github.com/<你的账号>/<仓库>/blob/main/PRIVACY_POLICY.md
# TOS_URL=
# PRIVACY_URL=

